# Copy to backend/.env (optional — shell env also works)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/hpcl_solar
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Treat feed stale if no sample within this many seconds (default 20 min)
STALE_AFTER_SEC=1800
# Persist plant_weather / GHI every N seconds
WEATHER_SAMPLE_SEC=30
# Plant site (Devanagonthi terminal)
PLANT_LAT=12.9862093
PLANT_LON=77.8467266
PLANT_LABEL=Devanagonthi, Karnataka
PLANT_ID=402
